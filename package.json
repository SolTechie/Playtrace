{
  "name": "playtrace",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "data:prepare": "node scripts/prepare-data.mjs",
    "data:import": "node --env-file=.env.local scripts/import-supabase.mjs",
    "bridge": "node --import tsx bridge/index.ts",
    "db:migrate": "node --env-file=.env.database scripts/migrate.mjs",
    "invite:create": "node --env-file=.env.local scripts/create-invite.mjs",
    "bridge:setup": "node scripts/setup-bridge.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:test": "node scripts/test-desktop.mjs",
    "auth:setup": "node --env-file=.env.local scripts/setup-google-auth.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "jose": "6.2.12",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.32.0"
  }
}
